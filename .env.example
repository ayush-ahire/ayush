# OpenRouter API key — used server-side only, by the /api/chat route.
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Resend API key — used server-side only, by the /api/contact route.
# Get one at https://resend.com/api-keys
RESEND_API_KEY=

# Destination inbox for contact form submissions (must be a verified sender
# or domain in Resend).
CONTACT_EMAIL=

# Canonical production origin, used for metadata, canonical URLs, sitemap.xml
# and robots.txt. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://example.com